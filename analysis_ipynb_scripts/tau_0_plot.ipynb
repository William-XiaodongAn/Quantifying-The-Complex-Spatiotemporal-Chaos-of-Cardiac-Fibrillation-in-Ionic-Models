    "import mpl_scatter_density\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.colors import LinearSegmentedColormap\n",
    "\n",
    "# Viridis-like colormap with white background\n",
    "white_viridis = LinearSegmentedColormap.from_list('white_viridis', [\n",
    "    (0.0, '#ffffff'),\n",
    "    (0.02, '#440154'),\n",
    "    (0.25, '#3b518a'),\n",
    "    (0.5, '#208f8c'),\n",
    "    (0.75, '#5bc862'),\n",
    "    (1.0, '#fde724'),\n",
    "], N=256)\n",
    "\n",
    "\n",
    "def using_mpl_scatter_density(ax, x, y, v, label, title):\n",
    "    density = ax.scatter_density(x, y, cmap=white_viridis, dpi=30, vmin=0, vmax=v)\n",
    "    ax.set_aspect('auto')\n",
    "    ax.text(0.04, 0.96, label, transform=ax.transAxes, fontsize=30, color='red', fontweight='bold',\n",
    "            va='top', ha='left')\n",
    "    ax.set_xlim(0, 300)\n",
    "    ax.set_ylim(0, 300)\n",
    "    ax.set_xticks([0, 300])\n",
    "    ax.set_yticks([0, 150,300])\n",
    "    ax.set_xlabel(r'DI')\n",
    "    ax.set_ylabel(r'APD')\n",
    "    ax.tick_params(axis='both', which='major', labelsize=16)  # bigger ticks\n",
    "    #ax.set_title(title)\n",
    "    return density\n",
    "\n",
    "\n",
    "letters = ['A', 'B', 'C']\n",
    "fig, axes = plt.subplots(1, 3, figsize=(13.4, 5), subplot_kw={'projection': 'scatter_density'})\n",
    "\n",
    "# Keep the last density object for the colorbar\n",
    "densities = []\n",
    "for idx, (ax, i) in enumerate(zip(axes, [0, 1, 2])):\n",
    "    y, x = get_restitution2(result_4_uvw_list[0][i][0][0])\n",
    "    title = r'$\\tau_{0}$ = ' + str(result_4_tau_r_list[i])\n",
    "    density = using_mpl_scatter_density(ax, x, y, 100, letters[idx], title)\n",
    "    densities.append(density)\n",
    "\n",
    "# Add a single colorbar beneath all plots\n",
    "cbar = fig.colorbar(\n",
    "    densities[-1],                   # last artist, all have same scale\n",
    "    ax=axes,                         # reference all axes\n",
    "    orientation='horizontal',\n",
    "    fraction=0.06,                   # relative size of colorbar\n",
    "    pad=0.15,                        # space between subplots and colorbar\n",
    "    aspect=40,                       # length vs. width ratio\n",
    ")\n",
    "cbar.set_label('Point Density', fontsize=20)\n",
    "cbar.ax.set_position([\n",
    "    cbar.ax.get_position().x0 - 0.02,  # shift left (decrease this number more if needed)\n",
    "    cbar.ax.get_position().y0,         # keep same vertical\n",
    "    cbar.ax.get_position().width,      # same width\n",
    "    cbar.ax.get_position().height      # same height\n",
    "])\n",
    "cbar.ax.tick_params(labelsize=16)   # make colorbar tick labels bigger\n",
    "\n",
    "# remove per-axes labels\n",
    "for ax in axes:\n",
    "    ax.set_xlabel('')\n",
    "    ax.set_ylabel('')\n",
    "\n",
    "# only show y tick labels on the first subplot (optional, cleaner)\n",
    "for ax in axes[1:]:\n",
    "    ax.set_yticklabels([])\n",
    "\n",
    "# big, shared labels\n",
    "#fig.supylabel('APD', fontsize=22, x=0.02,y=0.59)   # move a bit left so it clears the panels\n",
    "#fig.supxlabel('DI',  fontsize=22, y=0.15)   # raise if it clashes with the colorbar\n",
    "\n",
    "# give room for the colorbar + shared xlabel\n",
    "fig.subplots_adjust(wspace=0.1, hspace=0.0,bottom=0.28, left=0.08)  # tweak if needed\n",
    "plt.savefig('tau_0_rest_curve.png', dpi=300, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n"
   ]
